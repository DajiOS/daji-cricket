{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "test"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dajicricket.com",
        "EXPO_PUBLIC_APP_ENV": "live"
      }
    },
    "preview-customer": {
      "extends": "preview",
      "channel": "preview-customer",
      "env": {
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_APP_ENV": "test"
      }
    },
    "production-customer": {
      "extends": "production",
      "channel": "production-customer",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dajicricket.com",
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_APP_ENV": "live"
      }
    },
    "preview-admin": {
      "extends": "preview",
      "channel": "preview-admin",
      "env": {
        "APP_VARIANT": "admin",
        "EXPO_PUBLIC_APP_ENV": "test"
      }
    },
    "production-admin": {
      "extends": "production",
      "channel": "production-admin",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.dajicricket.com",
        "APP_VARIANT": "admin",
        "EXPO_PUBLIC_APP_ENV": "live"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {}
    },
    "production-customer": {
      "extends": "production",
      "ios": {
        "ascAppId": "6826630876"
      }
    },
    "production-admin": {
      "extends": "production",
      "ios": {
        "ascAppId": "6826631859"
      }
    }
  }
}
