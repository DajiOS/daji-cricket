{
  "expo": {
    "name": "Daji Cricket Ground",
    "slug": "daji-cricket-ground",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0c0b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dajicricket.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Daji Cricket Ground uses the camera to take photos that prove a task is done.",
        "NSPhotoLibraryUsageDescription": "Daji Cricket Ground uses your photos so you can choose a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dajicricket.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0c0b"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#c9a24b"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Daji Cricket Ground uses the camera to take photos that prove a task is done.",
          "photosPermission": "Daji Cricket Ground uses your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0c0b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "scheme": "dajicricket",
    "extra": {
      "eas": {
        "projectId": "44ea1bd5-2813-4d4e-85b4-c5dd3baadac0"
      }
    },
    "owner": "daji-cricket-ground"
  }
}
