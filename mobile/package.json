{
  "name": "daji-cricket-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "eas:preview": "eas build --profile preview --platform all",
    "eas:production": "eas build --profile production --platform all",
    "eas:update": "eas update --auto",
    "eas:submit": "eas submit --profile production --platform all"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-build-properties": "~0.13.1",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-notifications": "~0.29.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-updates": "~0.26.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
