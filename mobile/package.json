{
  "name": "daji-cricket-app",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "eas:preview": "eas build --profile preview-customer --platform all && eas build --profile preview-admin --platform all",
    "eas:production": "eas build --profile production-customer --platform all --auto-submit-with-profile production-customer && eas build --profile production-admin --platform all --auto-submit-with-profile production-admin",
    "eas:update": "eas update --auto"
  },
  "dependencies": {
    "expo": "~54.0.38",
    "expo-asset": "~12.0.14",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "typescript": "~5.9.2"
  }
}
