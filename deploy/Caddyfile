# Caddy gets and renews the HTTPS certificate by itself once the DNS record for the host points at this server.
{$API_HOST} {
	encode zstd gzip
	reverse_proxy api:4000 {
		# live camera pictures are a long-running stream: pass each picture on straight away
		flush_interval -1
	}
	header -Server
	log
}

# The public website: www.dajicricket.com is the main address; the bare dajicricket.com redirects to it.
# HTTPS certificates start working once the DNS records for these names point at this server.
www.{$SITE_HOST:dajicricket.com} {
	encode zstd gzip
	reverse_proxy api:4000 {
		# live camera pictures are a long-running stream: pass each picture on straight away
		flush_interval -1
	}
	header -Server
	log
}
{$SITE_HOST:dajicricket.com} {
	redir https://www.{$SITE_HOST:dajicricket.com}{uri} permanent
}

# The media CDN (deploy/CDN.md) fetches photos, videos and the background films from this server over plain HTTP, by the server's
# own address. Only those files are answered on it; the named sites above keep their HTTPS and their redirect from http://.
http:// {
	@files path /media/* /api/media/* /assets/*
	handle @files {
		reverse_proxy api:4000
	}
	handle {
		respond "Not found" 404
	}
	header -Server
}
