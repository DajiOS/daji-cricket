# Copy to deploy/.env and fill in. Never commit the real file.
API_HOST=api.dajicricket.com
PUBLIC_URL=https://dajicricket.com
API_URL=https://api.dajicricket.com
# 32+ random characters:  openssl rand -base64 48
JWT_SECRET=
# Encrypts 2-step sign-in secrets. 24+ characters. KEEP A COPY SOMEWHERE SAFE: without it those secrets cannot be read.
FIELD_KEY=
# Encrypts backups. KEEP A COPY AWAY FROM THE SERVER: without it a backup cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_ENABLED=on
BACKUP_KEEP=14
DEMO_MODE=off
# Optional: the CDN address that serves photos, videos and the background films (deploy/CDN.md), e.g. https://d1abcd2efgh3.cloudfront.net
# Leave empty and this server serves them itself.
MEDIA_CDN=
# Razorpay (test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp sign-in codes (Meta WhatsApp Business Cloud API)
# Code sign-up and sign-in stay off until OTP_SIGNIN=on (turn it on once the OTP template is approved in Meta)
OTP_SIGNIN=off
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=daji_otp
# Utility template with 3 text variables: {{1}} name, {{2}} phone, {{3}} message. Sent to the contact number when an enquiry arrives.
WHATSAPP_ALERT_TEMPLATE=daji_enquiry_alert
WHATSAPP_LANG=en

# Text-message back-up for sign-in codes (MSG91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Email through Gmail: a Google App Password (Google Account > Security > App passwords), not the normal password
GMAIL_USER=dajicricket@gmail.com
GMAIL_APP_PASSWORD=

# Optional: Sign in with Microsoft in the phone apps. From an app registration in the Microsoft Entra admin centre
# (entra.microsoft.com > App registrations), with the redirect address https://api.dajicricket.com/api/auth/microsoft/callback (Web).
# It signs in people who already have an account with the same email; it never makes new accounts.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common   # common = work, school and personal accounts; or your own tenant id to allow only your organisation

# Optional: Ask AI that can answer free-form questions. Without a key it still answers common questions from the built-in reports.
# The key stays on the server (never in git, never sent to the browser). Every question to Claude costs money: a small model is used,
# each person is limited to AI_LIMIT_PER_HOUR questions an hour, and you can set a monthly spend limit in the Anthropic console.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODE=claude          # claude = every question goes to Claude; auto = only questions the built-in answerer cannot read; builtin = never
# AI_MODEL=claude-haiku-5-5
# AI_LIMIT_PER_HOUR=30
